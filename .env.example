# Copie este arquivo para .env e coloque sua chave (https://aistudio.google.com/apikey)
GEMINI_API_KEY=sua-chave-aqui

# Modelo usado nas chamadas. Confira no AI Studio qual Flash está disponível no plano gratuito.
GEMINI_MODEL=gemini-3.1-flash-lite

# Alertas do n8n (opcional): token do @BotFather e id da sua conversa com o bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
